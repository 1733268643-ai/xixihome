# XixiHome Classic 后端配置示例。复制为 backend/.env 后填写；不要提交 .env。

# ---- 基础 ----
PORT=3001
NODE_ENV=production

# ---- 模型 ----
# 主对话模型：任意兼容 OpenAI /chat/completions 的服务均可。
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODELS=gpt-4.1-mini,gpt-5-mini,deepseek-chat
TEMPERATURE=0.75
MAX_REPLY_TOKENS=1500
MAX_CONTEXT_ROUNDS=20
CONTEXT_MESSAGES=20

# 可选：Anthropic / OpenAI / DeepSeek 密钥。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 可选：对话摘要压缩。
COMPRESS_PROVIDER=openai
COMPRESS_API_KEY=
COMPRESS_BASE_URL=
COMPRESS_MODEL=
COMPRESS_KEEP_ROUNDS=8

# 本地身份/记忆文件载入方式：balanced（默认）/ core / full。
MEMORY_LOAD_MODE=balanced
MEMORY_RECENT_FILES=5

# 可选：本机 Claude Code 作为聊天后端。
CLAUDE_CLI_CWD=
CLAUDE_CLI_DISALLOWED_TOOLS=

# ---- 存储 ----
# 可选：Supabase 持久化。留空时使用本地文件存储，重启后可能清空。
SUPABASE_URL=
SUPABASE_KEY=
PHONE_ACTIVITY_SUPABASE_URL=
PHONE_ACTIVITY_SUPABASE_KEY=

# 可选：本地文件路径覆盖。
XIXIHOME_CHAT_STORE_FILE=
XIXIHOME_LIFE_STORE_FILE=
CALL_LOG_DIR=

# ---- 推送 ----
BARK_KEY=
BARK_ICON_URL=

# ---- GitHub 同步 ----
GITHUB_TOKEN=
GITHUB_REPO=your-org/xixihome
GITHUB_BRANCH=main
GITHUB_MEMORY_REPO=your-org/your-memory-repo
GITHUB_MEMORY_BRANCH=main
GITHUB_MEMORY_TOKEN=

# ---- 心潮 / Ombre Brain ----
XINCHAO_URL=
XINCHAO_TOKEN=
XINCHAO_EVENT_PATH=
OMBRE_URL=
OMBRE_TOKEN=
MIND_TIMEOUT_MS=12000
MIND_CACHE_MS=60000
LMC5_DATABASE_URL=postgresql://lmc5:xixi_memory_2026@localhost:5432/lmc5

# ---- 设备 / 第三方服务代理 ----
READING_API_URL=
READING_API_TOKEN=
NETEASE_MCP_URL=
NETEASE_MCP_TOKEN=
STACKCHAN_MCP_URL=
STACKCHAN_MCP_TOKEN=
VPS_METRICS_URL=
VPS_METRICS_TOKEN=

# ---- 工具与动作鉴权 ----
XIXI_TOOLS_SECRET=
ACTIVITY_SECRET=
CHAT_ACTIONS_API_KEY=

# ---- 前端访问门锁 ----
ACCESS_PASSWORD=

# ---- 桥接 / 终端 ----
BRIDGE_TMUX_SESSION=xixihome
BRIDGE_CHAT_FILE=
BRIDGE_MACHINE_TOKEN=
BRIDGE_WEBHOOK_TOKEN=
BRIDGE_CLAUDE_MODELS=
VOICE_TMUX_TOKEN=
VOICE_ACTIVE_FLAG=
XIXIVOICE_SAY_SCRIPT=scripts/xixi-voice-say.sh
BRIDGE_INBOX=/tmp/xixihome-bridge-inbox.jsonl

# ---- TTS ----
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=
MINIMAX_VOICE_ID=

# ---- 梦境 ----
DREAM_PROVIDER=openai
DREAM_API_KEY=
DREAM_BASE_URL=
DREAM_MODEL=
DREAM_SECRET=

# ---- 环境感知 ----
HOME_LAT=
HOME_LON=
HOME_LABEL=
HOME_RADIUS_KM=1
