# PaiHome Classic 后端配置示例。复制为 backend/.env 后填写；不要提交 .env。
PORT=3001

# 主对话模型：任意兼容 OpenAI /chat/completions 的服务均可。
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODELS=gpt-4.1-mini,gpt-5-mini,deepseek-chat
TEMPERATURE=0.75
MAX_REPLY_TOKENS=1500

# 前端访问门锁。生产环境务必填写强密码。
ACCESS_PASSWORD=

# 对话上下文与可选摘要。
MAX_CONTEXT_ROUNDS=20
COMPRESS_KEEP_ROUNDS=8
COMPRESS_PROVIDER=openai
COMPRESS_API_KEY=
COMPRESS_BASE_URL=
COMPRESS_MODEL=

# 本地身份/记忆文件载入方式：balanced（默认）/ core / full。
MEMORY_LOAD_MODE=balanced
MEMORY_RECENT_FILES=5

# 可选：从 GitHub 私有仓库同步 CLAUDE.md 与 memories/。
GITHUB_TOKEN=
GITHUB_MEMORY_REPO=your-org/your-memory-repo
GITHUB_MEMORY_BRANCH=main

# 可选：设备/工具库代理。
GUCHUAN_TOOLS_BASE_URL=
GUCHUAN_TOOLS_SECRET=
CHAT_ACTIONS_API_KEY=
PHONE_ACTIVITY_SUPABASE_URL=
PHONE_ACTIVITY_SUPABASE_KEY=
ACTIVITY_SECRET=

# 可选：梦境/定时提醒与 Bark。
DREAM_PROVIDER=openai
DREAM_API_KEY=
DREAM_BASE_URL=
DREAM_MODEL=
DREAM_SECRET=
BARK_KEY=
BARK_ICON_URL=

# 可选：持久化数据库。留空时使用内存存储，重启后会清空。
SUPABASE_URL=
SUPABASE_KEY=

# 可选：心潮 Dynamic Mind / Ombre Brain，源码不包含在本包内。
XINCHAO_URL=https://xinchao.example.com
XINCHAO_TOKEN=
# 仅在你的心潮服务已提供事件入口时填写，例如 /v1/event。
XINCHAO_EVENT_PATH=
OMBRE_URL=https://ombre.example.com/mcp
OMBRE_TOKEN=
MIND_TIMEOUT_MS=12000

# 可选：阅读、网易云、StackChan 等服务端代理。令牌不返回前端。
READING_API_URL=
READING_API_TOKEN=
NETEASE_MCP_URL=
NETEASE_MCP_TOKEN=
STACKCHAN_MCP_URL=
STACKCHAN_MCP_TOKEN=
VPS_METRICS_URL=
VPS_METRICS_TOKEN=

# 可选：终端桥接与 Codex App Server。
BRIDGE_MACHINE_TOKEN=
CODEX_BIN=
CODEX_BRIDGE_CWD=
CODEX_BRIDGE_MODEL=
CODEX_BRIDGE_STATE=
PAIVOICE_SAY_SCRIPT=

# 可选：环境感知的默认位置。不配置则显示“未设置位置”。
HOME_LAT=
HOME_LON=
HOME_LABEL=
HOME_RADIUS_KM=1
